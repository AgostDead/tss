-- ---- Universal HTTP Request ----
local function getRequestFunc()
    return request or http_request or (http and http.request)
        or (syn and syn.request) or (fluxus and fluxus.request)
        or (krnl and krnl.request) or (delta and delta.request)
        or (codex and codex.request)
end

local function universalRequest(options)
    local req = getRequestFunc()
    if req then
        local ok, res = pcall(req, options)
        if ok then return res end
    end
    return nil
end

local function universalHttpGet(url)
    if game and game.HttpGet then
        local ok, res = pcall(function() return game:HttpGet(url) end)
        if ok and res then return res end
    end
    if http and http.get then
        local ok, res = pcall(function() return http.get(url) end)
        if ok and res then return res end
    end
    local res = universalRequest({ Url = url, Method = "GET" })
    return res and res.Body or nil
end


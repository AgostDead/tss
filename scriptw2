local function GetSavedConfigs()
    local list = {}
    if listfiles then
        for _, file in ipairs(listfiles("")) do
            local name = string.match(file, "TSSHub_Config_(.-)%.json$")
            if name then
                table.insert(list, name)
                if #list >= 10 then break end
            end
        end
    end
    if #list == 0 then table.insert(list, "None") end
    return list
end


task.spawn(function()
    task.wait(1)
    local AUTOLOAD_FILE = "TSSHub_AutoLoad.json"
    if isfile(AUTOLOAD_FILE) then
        local ok, content = pcall(function() return readfile(AUTOLOAD_FILE) end)
        if ok then
            local okDec, autoData = pcall(function() return HttpService:JSONDecode(content) end)
            if okDec and autoData and autoData.AutoLoadConfig then
                local autoConfigName = autoData.AutoLoadConfig
                local configFile = "TSSHub_Config_" .. autoConfigName .. ".json"
                if isfile(configFile) then
                    local okRead, configContent = pcall(function() return readfile(configFile) end)
                    if okRead then
                        local okParse, configData = pcall(function() return HttpService:JSONDecode(configContent) end)
                        if okParse and type(configData) == "table" then
                            for flagName, savedValue in pairs(configData) do
                                if Rayfield.Flags[flagName] and Rayfield.Flags[flagName].Set then
                                    Rayfield.Flags[flagName]:Set(savedValue)
                                end
                            end
                            activeConfigName = autoConfigName
                            ConfigStatusLabel:Set("Active Config: [" .. activeConfigName .. "]")
                            Rayfield:Notify({
                                Title = "Auto Loaded!",
                                Content = "Applied configuration: [" .. autoConfigName .. "]",
                                Duration = 4
                            })
                        end
                    end
                end
            end
        end
    end
end)

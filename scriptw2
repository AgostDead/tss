local currentActiveMathMessage = ""
local function solveAndAnswer(messageText, isManual)
   if not getgenv().AutoSolution and not isManual then return end
   local mathExpr = string.match(messageText, "What is%s+(.-)%s*%?")
   local rewardText = string.match(messageText, "you get:%s*(.*)") or "Unknown"
   if mathExpr then
      local clean = string.gsub(mathExpr, "[^%d%+%-%*%/%^%.%s]", "")
      local func = loadstring("return " .. clean)
      if func then
         local ok, result = pcall(func)
         if ok and result then
            local response = string.format("%.1f", result)
            if response:sub(-2) == ".0" then response = string.format("%d", result) end
            SolutionLabel:Set(string.format("%s = %s | Reward: %s", clean, response, rewardText))
            local finalOutput = getgenv().HideAnswer and ("/e " .. response) or response
            local TCS = game:GetService("TextChatService")
            local ch = TCS.TextChannels:FindFirstChild("RBXGeneral")
            if ch then
               if not isManual then
                  local delay = math.random(getgenv().DelayMin * 1000, getgenv().DelayMax * 1000) / 1000
                  task.wait(delay)
                  if getgenv().AutoSolution then ch:SendAsync(finalOutput) end
               else
                  ch:SendAsync(finalOutput)
               end
            end
         end
      end
   end
end

local TCS = game:GetService("TextChatService")
for _, channel in ipairs(TCS.TextChannels:GetChildren()) do
